    },
    {
      "kind": "page",
      "node_id": "m8_diner",
      "page_id": "m8.a.diner.p02",
      "speaker_id": "maddy",
      "display_name": "MADDY",
      "text": "La 7:40 prende la coincidenza a Spokane. Passa alla fermata del lago — quella delle 11 no, ma parte a orario.",
      "dom_text": "MADDY: La 7:40 prende la coincidenza a Spokane. Passa alla fermata del lago — quella delle 11 no, ma parte a orario.",
      "objective": "Passa dal diner, questo pomeriggio.",
      "map": "diner"
    },
    {
      "kind": "page",
      "node_id": "m8_diner",
      "page_id": "m8.a.diner.p03",
      "speaker_id": "cooper",
      "display_name": "COOPER",
      "text": "Torna a casa, signorina Ferguson?",
      "dom_text": "COOPER: Torna a casa, signorina Ferguson?",
      "objective": "Passa dal diner, questo pomeriggio.",
      "map": "diner"
    },
    {
      "kind": "page",
      "node_id": "m8_diner",
      "page_id": "m8.a.diner.p04",
      "speaker_id": "maddy",
      "display_name": "MADDY",
      "text": "Torno al centralino della biblioteca. Mi tengono il posto fino a lunedì — l'ho fatto promettere per iscritto.",
      "dom_text": "MADDY: Torno al centralino della biblioteca. Mi tengono il posto fino a lunedì — l'ho fatto promettere per iscritto.",
      "objective": "Passa dal diner, questo pomeriggio.",
      "map": "diner"
    },
    {
      "kind": "page",
      "node_id": "m8_diner",
      "page_id": "m8.a.diner.p05",
      "speaker_id": null,
      "display_name": null,
      "text": "(Un avventore la saluta: \"Ciao, Laura\". Maddy non si volta subito.)",
      "dom_text": "(Un avventore la saluta: \"Ciao, Laura\". Maddy non si volta subito.)",
      "objective": "Passa dal diner, questo pomeriggio.",
      "map": "diner"
    },
    {
      "kind": "page",
      "node_id": "m8_diner",
      "page_id": "m8.a.diner.p06",
      "speaker_id": "maddy",
      "display_name": "MADDY",
      "text": "(senza acidità) Maddy. Con due D. Laura era mia cugina — io sono quella che porta gli occhiali nelle foto.",
      "dom_text": "MADDY: (senza acidità) Maddy. Con due D. Laura era mia cugina — io sono quella che porta gli occhiali nelle foto.",
      "objective": "Passa dal diner, questo pomeriggio.",
      "map": "diner"
    },
    {
      "kind": "page",
      "node_id": "m8_diner",
      "page_id": "m8.a.diner.p07",
      "speaker_id": "maddy",
      "display_name": "MADDY",
      "text": "Sono rimasta un giorno in più per zia Sarah. Uno. Poi Missoula si riprende il suo centralino.",
      "dom_text": "MADDY: Sono rimasta un giorno in più per zia Sarah. Uno. Poi Missoula si riprende il suo centralino.",
      "objective": "Passa dal diner, questo pomeriggio.",
