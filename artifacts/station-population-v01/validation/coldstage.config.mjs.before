      ].map(([name,time,elapsed])=>({name,settleMs:100,readyScript:`
        if(window.environmentCapture!==${JSON.stringify(name)}){
          GAME.AmbientLife.seek('diner',${time});GAME.EnvironmentReactions.reset('diner');
