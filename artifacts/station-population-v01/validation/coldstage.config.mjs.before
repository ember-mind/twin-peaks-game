        ['wipe-left','counter-wipe',100],['wipe-middle','counter-wipe',450],['wipe-right','counter-wipe',800],['wipe-return','counter-wipe',1100],['wipe-rest','counter-wipe',3000]
      ].map(([name,id,time])=>({name,settleMs:100,readyScript:`
        if(window.gestureCapture!==${JSON.stringify(name)}){GAME.CharacterActivity.preview('booth-sip',3000);GAME.CharacterActivity.preview('counter-wipe',3000);
          if(${JSON.stringify(id)}!==-1)GAME.CharacterActivity.preview(${JSON.stringify(id)},${time});
          window.gestureCapture=${JSON.stringify(name)};}return true;`}))
