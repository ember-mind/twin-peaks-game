        GAME.EnvironmentReactions.setPaused(true);
        window.machineStart=GAME.AmbientLife.snapshot('diner').items.find(e=>e.id==='coffee-machine').next;
      `,
      evidenceScript:`return {machine:GAME.AmbientLife.snapshot('diner').items.some(e=>e.type==='MACHINE_IDLE_ACTIVITY'),clock:GAME.AmbientLife.snapshot('diner').items.some(e=>e.type==='CLOCK_TICK'),door:GAME.EnvironmentReactions.snapshot('diner')[0].state};`,
      checks:[{path:'machine',equals:true},{path:'clock',equals:true},{path:'door',equals:'CLOSED'}],
