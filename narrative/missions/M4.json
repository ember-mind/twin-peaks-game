          "speaker_id": "cooper",
          "display_name": "COOPER"
        }
      ],
      "repeat": {
        "name": "COOPER",
        "text": "Il reparto aspetta la parola dello sceriffo. Anch'io.",
        "id": "m4.repeat.infermiera_attesa",
